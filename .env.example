# Required: Neon/Postgres content database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required for /admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Recommended in production. A connected Vercel Blob store provides this automatically
# and Vercel supplies the short-lived VERCEL_OIDC_TOKEN at runtime.
BLOB_STORE_ID=

# Legacy/manual Blob authentication only. Do not generate a random value.
# Without either complete Blob configuration, uploaded PDFs use the database fallback.
BLOB_READ_WRITE_TOKEN=

# Resend: Full access API key, verified sender, dedicated newsletter segment.
# Keep all of these server-only. Enable only after domain/webhook setup.
RESEND_API_KEY=
NEWSLETTER_FROM_EMAIL=
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_WEBHOOK_SECRET=
CRON_SECRET=
NEWSLETTER_ENABLED=false

# Required for public newsletter signup (Cloudflare Turnstile Managed widget).
# Allow only eloviz.hu / www.eloviz.hu. Secret must stay server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
